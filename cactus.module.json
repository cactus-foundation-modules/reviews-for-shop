{
  "name": "reviews-for-shop",
  "version": "0.1.8",
  "tablePrefix": "rvw_",
  "description": "Customer reviews for the Shop: shoppers rate a product out of five and say why, the ratings show on the product page as a Reviews tab or as blocks you place yourself, and every review lands in an admin list where you publish it, reply to it or bin it. Reviews can go up on their own or wait for you, and can be limited to people who actually bought the thing.",
  "requiresCoreVersion": "0.5.1026",
  "requiresModules": [
    {
      "name": "shop",
      "minVersion": "0.1.245"
    }
  ],
  "requiredEnvVars": [],
  "permissions": [
    "reviews.access",
    "reviews.manage"
  ],
  "cookieCategories": [],
  "emailTemplates": {
    "groupLabel": "Reviews",
    "import": "./lib/email-templates",
    "export": "reviewsEmailTemplates"
  },
  "settingsTabs": [
    {
      "id": "reviews-for-shop",
      "label": "Reviews",
      "permission": "reviews.manage",
      "host": "shop.settings-sub-tabs",
      "import": "./components/admin/ReviewsSettingsTab",
      "component": "ReviewsSettingsTab"
    }
  ],
  "extensionPoints": [
    {
      "point": "shop.products-tabs",
      "id": "reviews-for-shop",
      "label": "Reviews",
      "order": 50,
      "permission": "reviews.access",
      "import": "./components/admin/ReviewsTab",
      "component": "ReviewsTab"
    },
    {
      "point": "shop.product-detail-tabs",
      "id": "product-reviews",
      "import": "./lib/detail-tab-provider",
      "component": "reviewsTabProvider"
    }
  ],
  "puckBlocks": [
    {
      "type": "ShopProductReviews",
      "import": "./components/puck/ShopProductReviews",
      "component": "shopProductReviewsPuckComponent",
      "rscComponent": "shopProductReviewsPuckRscComponent",
      "rscImport": "./components/puck/ShopProductReviews.rsc",
      "layoutTypes": [
        "shopProductDetail",
        "shopProduct"
      ]
    },
    {
      "type": "ShopProductRatingSummary",
      "import": "./components/puck/ShopProductRatingSummary",
      "component": "shopProductRatingSummaryPuckComponent",
      "rscComponent": "shopProductRatingSummaryPuckRscComponent",
      "rscImport": "./components/puck/ShopProductRatingSummary.rsc",
      "layoutTypes": [
        "shopProductDetail",
        "shopProduct"
      ]
    },
    {
      "type": "ShopReviewsWall",
      "import": "./components/puck/ShopReviewsWall",
      "component": "shopReviewsWallPuckComponent",
      "rscComponent": "shopReviewsWallPuckRscComponent",
      "rscImport": "./components/puck/ShopReviewsWall.rsc"
    }
  ],
  "cronJobs": [
    {
      "path": "/api/m/reviews-for-shop/cron/review-invites",
      "schedule": "0 8 * * *"
    }
  ],
  "memberExtensions": {
    "activityTypes": [],
    "notificationCategories": [],
    "routeTiers": [],
    "dataExportPath": "/api/m/reviews-for-shop/member/gdpr-export"
  },
  "teardown": [
    "rvw_invites",
    "rvw_reviews",
    "rvw_settings"
  ]
}
